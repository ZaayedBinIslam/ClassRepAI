# Copy this file to .env and fill in the values. Never commit .env.

# From @BotFather. Also run /setprivacy -> Disable so the bot can read group messages.
TELEGRAM_BOT_TOKEN=

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Exact Gemma 4 model ID. Run `python scripts/check_model.py` to list the available ones.
GEMMA_MODEL=

# Local: SQLite. Production (Neon): postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=sqlite+aiosqlite:///./classrepai.db

# Empty = local polling mode. Set to your public URL (e.g. https://classrepai.onrender.com) = webhook mode.
PUBLIC_BASE_URL=

# Any long random string. Used as the Telegram webhook secret and the /tick secret.
APP_SECRET=
